{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "packages/fetchlet/src/runtime/**/*.ts",
    "packages/web/src/**/*.ts",
    "packages/web/vite.config.ts",
    "tools/bench/bare/entry.ts",
    "tools/bench/probe/entry.ts"
  ],
  "exclude": ["fixtures/probe/run.ts"]
}
