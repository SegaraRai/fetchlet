{
  "include": ["app/**/*", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite-plus/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "noEmit": true,
    // fetchlet resolves to its TypeScript sources in the workspace.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  }
}
