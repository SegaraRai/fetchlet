---
import Counter from "../components/Counter.svelte";
import Page from "../layouts/Page.astro";

let name = Astro.url.searchParams.get("name") ?? "fetchlet";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  name = String(form.get("name") ?? "").trim() || "fetchlet";
  Astro.cookies.set("visitor", name, { path: "/", sameSite: "lax", secure: false });
}
const response = await Astro.locals.env.RUST.fetch("https://fetchlet.internal/greeting");
const greeting = await response.json();
---

<Page title="Astro greeting">
  <h1>Hello, {name}</h1>
  <p>{Astro.locals.env.MESSAGE}</p>
  <p>{greeting.message}</p>
  <form method="POST">
    <label for="name">Name</label>
    <input id="name" name="name" value={name} />
    <button type="submit">Greet</button>
  </form>
  <Counter client:load />
  <a href="/about">About</a>
</Page>
