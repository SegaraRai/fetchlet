---
import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    color: #243047;
    background: #f4f6f8;
    font-family: system-ui, sans-serif;
  }
  main {
    max-width: 40rem;
    margin: 4rem auto;
    padding: 2rem;
    background: white;
    border-radius: 1rem;
  }
  form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 2rem 0;
  }
  input,
  button {
    font: inherit;
    padding: 0.5rem 0.75rem;
  }
  a {
    display: block;
    margin-top: 2rem;
  }
</style>
