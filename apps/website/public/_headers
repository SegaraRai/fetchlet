# Asset file names contain a content hash, so a changed file always has a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Other sites may embed the brand files.
# The file names stay the same when the logo changes, so caches must expire.
/brand/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400

# Markdown alternates repeat the HTML pages. Search results must link to the HTML pages.
/index.md
  X-Robots-Tag: noindex

/*/index.md
  X-Robots-Tag: noindex

/*/index.mdx
  X-Robots-Tag: noindex
