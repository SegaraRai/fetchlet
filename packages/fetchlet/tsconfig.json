{
  // Strict checks for the build modules and framework adapters. The runtime is
  // checked with the guest entries by the root tsconfig.json.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    // TypeScript emits no declarations for a file it reaches through
    // node_modules, so the packed declarations reach the sources of
    // @fetchlet/web and @fetchlet/node by path.
    "paths": {
      "@fetchlet/node/*": ["../node/src/*.ts"],
      "@fetchlet/node/async-hooks/serialized": ["../node/src/async-hooks-serialized.ts"],
      "@fetchlet/node/timers/promises": ["../node/src/timers-promises.ts"],
      "@fetchlet/node/assert/strict": ["../node/src/assert-strict.ts"],
      "@fetchlet/node/stream/promises": ["../node/src/stream-promises.ts"],
      "@fetchlet/node/stream/web": ["../node/src/stream-web.ts"],
      "@fetchlet/node/util/types": ["../node/src/util-types.ts"],
      "@fetchlet/web": ["../web/src/index.ts"],
      "@fetchlet/web/*": ["../web/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "exclude": ["src/runtime/**"]
}
