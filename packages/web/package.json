{
  "name": "@fetchlet/web",
  "version": "0.1.1",
  "description": "Web API implementations that run inside a fetchlet engine on the host operations of fetchlet-web",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SegaraRai/fetchlet.git",
    "directory": "packages/web"
  },
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./async-context": "./src/async-context.ts",
    "./capabilities": "./src/capabilities.ts",
    "./channels": "./src/channels.ts",
    "./gaps": "./src/gaps.ts",
    "./host": "./src/host.ts",
    "./sockets": "./src/sockets.ts",
    "./websocket": "./src/websocket.ts",
    "./wire": "./src/wire.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./async-context": "./dist/async-context.js",
      "./capabilities": "./dist/capabilities.js",
      "./channels": "./dist/channels.js",
      "./gaps": "./dist/gaps.js",
      "./host": "./dist/host.js",
      "./sockets": "./dist/sockets.js",
      "./websocket": "./dist/websocket.js",
      "./wire": "./dist/wire.js"
    },
    "access": "public"
  },
  "dependencies": {
    "@exodus/bytes": "catalog:dep",
    "@formatjs/intl-datetimeformat": "catalog:dep",
    "@formatjs/intl-displaynames": "catalog:dep",
    "@formatjs/intl-durationformat": "catalog:dep",
    "@formatjs/intl-getcanonicallocales": "catalog:dep",
    "@formatjs/intl-listformat": "catalog:dep",
    "@formatjs/intl-locale": "catalog:dep",
    "@formatjs/intl-numberformat": "catalog:dep",
    "@formatjs/intl-pluralrules": "catalog:dep",
    "@formatjs/intl-relativetimeformat": "catalog:dep",
    "@formatjs/intl-segmenter": "catalog:dep",
    "@formatjs/intl-supportedvaluesof": "catalog:dep",
    "core-js-pure": "catalog:dep",
    "web-streams-polyfill": "catalog:dep"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
