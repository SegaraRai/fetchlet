    "./util/types": "./src/util-types.ts",
    "./zlib": "./src/zlib.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./assert": "./dist/assert.js",
      "./assert/strict": "./dist/assert-strict.js",
      "./async-hooks": "./dist/async-hooks.js",
      "./async-hooks/serialized": "./dist/async-hooks-serialized.js",
      "./buffer": "./dist/buffer.js",
      "./crypto": "./dist/crypto.js",
      "./diagnostics-channel": "./dist/diagnostics-channel.js",
      "./events": "./dist/events.js",
      "./host-apis": "./dist/host-apis.js",
      "./http": "./dist/http.js",
      "./https": "./dist/https.js",
      "./path": "./dist/path.js",
      "./process": "./dist/process.js",
      "./querystring": "./dist/querystring.js",
      "./stream": "./dist/stream.js",
      "./stream/promises": "./dist/stream-promises.js",
      "./stream/web": "./dist/stream-web.js",
      "./string-decoder": "./dist/string-decoder.js",
      "./timers": "./dist/timers.js",
      "./timers/promises": "./dist/timers-promises.js",
      "./url": "./dist/url.js",
      "./util": "./dist/util.js",
      "./util/types": "./dist/util-types.js",
      "./zlib": "./dist/zlib.js"
    }
